<?xml version="1.0" encoding="utf-8"?>
<ModPlus>
  <mncStripMtext
    LocalName="Formatlashni tozalash"
    Description="Koʻp qatorli matndan koʻrsatilgan formatlashni olib tashlash"
    FullDescription="Koʻp qatorli matn, multiizohlar, oʻlchamlar, blok atributlari va jadvallar formatlashini olib tashlash">
    <h1>Olib tashlanadigan formatlash turini tanlang</h1>
    <h2>Barchasini tanlash</h2>
    <h3>Tanlovni bekor qilish</h3>
    <h4>Qabul qilish</h4>
    <m1>Koʻp qatorli matnni oʻz ichiga olgan obyektlarni tanlang</m1>
    <s1>Tekislash</s1>
    <st1>Vertikal tekislashni olib tashlash. Vertikal tekislash matnda kasrlar mavjud boʻlganda paydo boʻladi</st1>
    <s2>Tabulyatsiya</s2>
    <st2>Gorizontal tabulyatsiyani olib tashlash</st2>
    <s3>Rang</s3>
    <st3>Matn rangini olib tashlash</st3>
    <s4>Maydonlar</s4>
    <st4>Maydonlarni oddiy matnga aylantirish</st4>
    <s5>Shrift</s5>
    <st5>Matndagi shrift qayta belgilanishlarini olib tashlash</st5>
    <s6>Balandlik</s6>
    <st6>Matn balandligi qayta belgilanishlarini olib tashlash</st6>
    <s7>Ustidan chizish</s7>
    <st7>Matnning ustidan chizilishini olib tashlash</st7>
    <s8>Satr koʻchirishlari</s8>
    <st8>Yangi satrga koʻchirishlarni olib tashlash</st8>
    <s9>Niqob</s9>
    <st9>Orqa fon niqobini olib tashlash</st9>
    <s10>Ustunlar</s10>
    <st10>Matndan ustunlarni olib tashlash</st10>
    <s11>Ustki chiziq</s11>
    <st11>Matndan ustki chiziqni olib tashlash</st11>
    <s12>Xatboshi</s12>
    <st12>Xatboshilarga boʻlinishni olib tashlash</st12>
    <s13>Ogʻish</s13>
    <st13>Matn ogʻishini olib tashlash</st13>
    <s14>Kasrlar</s14>
    <st14>Kasrli matn belgilanishini olib tashlash</st14>
    <s15>Belgilararo interval</s15>
    <st15>Belgilararo interval formatlashini olib tashlash</st15>
    <s16>Tagiga chizish</s16>
    <st16>Matndan tagiga chizishni olib tashlash</st16>
    <s17>Choʻzish koeffitsiyenti</s17>
    <st17>Siqish-choʻzish koeffitsiyenti qiymatini tiklash</st17>
    <s18>Uzilmas boʻshliq</s18>
    <st18>Matndan uzilmas boʻshliqlarni olib tashlash</st18>
    <s19>Xatboshini tekislash</s19>
    <st19>Matndan xatboshilar tekislanishini olib tashlash</st19>
  </mncStripMtext>
