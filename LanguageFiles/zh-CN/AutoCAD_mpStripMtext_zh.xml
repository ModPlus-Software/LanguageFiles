<?xml version="1.0" encoding="utf-8"?>
<ModPlus>
  <mpStripMtext
    LocalName="清除格式"
    Description="删除多行文字中指定的格式"
    FullDescription="删除多行文字、多重引线、标注、块属性和表格中的格式">
    <h1>选择要删除的格式类型</h1>
    <h2>全选</h2>
    <h3>取消选择</h3>
    <h4>应用</h4>
    <m1>选择包含多行文字的对象</m1>
    <s1>对齐</s1>
    <st1>删除垂直对齐。当文本中包含分数时会出现垂直对齐</st1>
    <s2>制表位</s2>
    <st2>删除水平制表位</st2>
    <s3>颜色</s3>
    <st3>删除文字颜色</st3>
    <s4>字段</s4>
    <st4>将字段转换为普通文本</st4>
    <s5>字体</s5>
    <st5>删除文本中的字体覆盖</st5>
    <s6>高度</s6>
    <st6>删除文字高度覆盖</st6>
    <s7>删除线</s7>
    <st7>删除文字的删除线</st7>
    <s8>换行符</s8>
    <st8>删除换行符</st8>
    <s9>背景遮罩</s9>
    <st9>删除背景遮罩</st9>
    <s10>分栏</s10>
    <st10>删除文本分栏</st10>
    <s11>上划线</s11>
    <st11>删除文字上划线</st11>
    <s12>段落</s12>
    <st12>删除段落分隔</st12>
    <s13>倾斜</s13>
    <st13>删除文字倾斜</st13>
    <s14>分数</s14>
    <st14>删除分数格式</st14>
    <s15>字符间距</s15>
    <st15>删除字符间距格式</st15>
    <s16>下划线</s16>
    <st16>删除文字下划线</st16>
    <s17>宽度因子</s17>
    <st17>重置宽度因子值</st17>
    <s18>不间断空格</s18>
    <st18>删除文本中的不间断空格</st18>
    <s19>段落对齐</s19>
    <st19>删除段落对齐方式</st19>
  </mpStripMtext>
</ModPlus>