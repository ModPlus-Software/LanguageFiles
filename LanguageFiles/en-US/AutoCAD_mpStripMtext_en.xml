<?xml version="1.0" encoding="utf-8"?>
<ModPlus>
  <mpStripMtext
    LocalName="Clear formatting"
    Description="Removing specified formatting from multiline text"
    FullDescription="Removing formatting from multiline text, multileaders, dimensions, block attributes, and tables">
    <h1>Select type of formatting to remove</h1>
    <h2>Check all</h2>
    <h3>Uncheck all</h3>
    <h4>Accept</h4>
    <m1>Select objects containing multiline text</m1>
    <s1>Alignment</s1>
    <st1>Remove vertical alignment. Vertical alignment appears when there are fractions in the text</st1>
    <s2>Tabs</s2>
    <st2>Remove horizontal tabs</st2>
    <s3>Color</s3>
    <st3>Remove text color</st3>
    <s4>Fields</s4>
    <st4>Convert fields to plain text</st4>
    <s5>Fonts</s5>
    <st5>Remove font overrides in text</st5>
    <s6>Height</s6>
    <st6>Remove text height overrides</st6>
    <s7>Strikethrough</s7>
    <st7>Remove strikethrough text</st7>
    <s8>Linefeed</s8>
    <st8>Remove leading linefeeds</st8>
    <s9>Mask</s9>
    <st9>Remove background mask</st9>
    <s10>Columns</s10>
    <st10>Remove columns from text</st10>
    <s11>Overline</s11>
    <st11>Remove overline from text</st11>
    <s12>Paragraph</s12>
    <st12>Remove paragraph breaks</st12>
    <s13>Oblique</s13>
    <st13>Remove oblique from text</st13>
    <s14>Stacking</s14>
    <st14>Convert stacking text to line text</st14>
    <s15>Tracking</s15>
    <st15>Remove space between characters</st15>
    <s16>Underline</s16>
    <st16>Turns underline off</st16>
    <s17>Width</s17>
    <st17>Reset width factor</st17>
    <s18>Non-breaking space</s18>
    <st18>Remove non-breaking spaces from text</st18>
    <s19>Paragraph alignment</s19>
    <st19>Remove paragraph alignments from text</st19>
  </mpStripMtext>
</ModPlus>