<UserControl x:Class="LangFilesEditor.UI.Infrastructure.Docking.DockSite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="0" MinWidth="0" />
            <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="RightColumn" Width="0" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="LeftHost"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <GridSplitter x:Name="LeftSplitter"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="0" MinHeight="0" />
                <RowDefinition x:Name="TopSplitterRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomSplitterRow" Height="Auto" />
                <RowDefinition x:Name="BottomRow" Height="0" MinHeight="0" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="TopHost"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <GridSplitter x:Name="TopSplitter"
                          Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <ContentControl x:Name="CenterHost"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <GridSplitter x:Name="BottomSplitter"
                          Grid.Row="3"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <ContentControl x:Name="BottomHost"
                            Grid.Row="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <Border x:Name="TopDropHint"
                    Grid.Row="0"
                    Background="#402196F3"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <Border x:Name="BottomDropHint"
                    Grid.Row="4"
                    Background="#402196F3"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
        </Grid>

        <GridSplitter x:Name="RightSplitter"
                      Grid.Column="3"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" />

        <ContentControl x:Name="RightHost"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <Border x:Name="LeftDropHint"
                Grid.Column="0"
                Background="#402196F3"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        <Border x:Name="RightDropHint"
                Grid.Column="4"
                Background="#402196F3"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>