<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infrastructure="clr-namespace:LangFilesEditor.UI.Infrastructure">

    <!--  Обвязка пристыкованных панелей. Стили намеренно не наследуют базовую кнопку:
          у неё акцентная заливка и минимальная ширина 88, а здесь нужен служебный
          квадрат 22x22 без заливки.  -->

    <!--  Значок кнопки — TextBlock из шрифта Segoe MDL2 Assets. Общий стиль TextBlock
          задаёт цвет сеттером, а сеттер перекрывает наследование, поэтому цвет значка
          приходится явно привязывать к Foreground самой кнопки  -->
    <Style x:Key="DockChromeGlyphStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Style>

    <Style x:Key="DockChromeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GrayBrush1}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource DockChromeGlyphStyle}" TargetType="{x:Type TextBlock}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Кнопка закрытия панели: красная подсветка, как у кнопки закрытия окна
          в сервере лицензий  -->
    <Style x:Key="DockChromeCloseButtonStyle"
           BasedOn="{StaticResource DockChromeButtonStyle}"
           TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource DockChromeGlyphStyle}" TargetType="{x:Type TextBlock}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MainRed}" />
                            <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Панель — карточка со скруглением, как в сервере лицензий. CornerClip обрезает
          содержимое: шапка и грид непрозрачные и иначе закрашивают углы  -->
    <Style x:Key="DockPanelChromeBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource EditorChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="infrastructure:CornerClip.Radius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Шапка панели: как шапка карточки — фон светлее тела, линия-разделитель  -->
    <Style x:Key="DockPanelHeaderBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorBorderBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
