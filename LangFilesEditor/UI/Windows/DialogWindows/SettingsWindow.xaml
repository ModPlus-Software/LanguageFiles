<Window x:Class="LangFilesEditor.UI.Windows.DialogWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Настройки"
        Width="480"
        Height="620"
        MinWidth="420"
        MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource DefaultFont}"
        mc:Ignorable="d">
    <Border Background="{DynamicResource EditorChromeBrushLight}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource EditorDialogTitleStyle}"
                       Text="Настройки редактора" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="Пути" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource EditorDialogFieldLabelStyle}"
                                       Text="Каталог LanguageFiles" />
                            <TextBox Margin="0,0,0,8"
                                     Style="{StaticResource EditorSettingsReadOnlyValueStyle}"
                                     Text="{Binding LanguageFilesPath, Mode=OneWay}"
                                     TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding OpenLanguageFilesFolderCommand}"
                                    Content="Открыть в проводнике"
                                    Style="{StaticResource EditorDialogButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="Языки" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource EditorDialogFieldLabelStyle}"
                                       Text="Порядок колонок в гриде (read-only)" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource EditorTextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Языки определяются по каталогам в LanguageFiles."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource EditorTextSecondaryBrush}"
                                       Text="Языки не найдены."
                                       Visibility="{Binding NoLanguages, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding Languages}"
                                          Visibility="{Binding HasLanguages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource EditorTextPrimaryBrush}"
                                                   Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="Диагностика" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Сканировать при запуске"
                                      Foreground="{DynamicResource EditorTextPrimaryBrush}"
                                      IsChecked="{Binding RunStartupDiagnosticsScan}" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RescanDiagnosticsCommand}"
                                    Content="Сканировать сейчас"
                                    Style="{StaticResource EditorDialogButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="Тема" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource EditorDialogFieldLabelStyle}"
                                       Text="Оформление интерфейса" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedThemeName}"
                                      Style="{StaticResource EditorDialogComboBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="О версии" />
                            <StackPanel Margin="0,6,0,0"
                                        Orientation="Horizontal">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource EditorTextSecondaryBrush}"
                                           Text="Версия локализации:" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource EditorTextPrimaryBrush}"
                                           Text="{Binding LocalVersion}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Style="{StaticResource EditorDialogSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource EditorDialogSectionTitleStyle}"
                                       Text="Расширения" />
                            <Grid Grid.Row="1"
                                  Margin="0,6,0,0">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource EditorTextSecondaryBrush}"
                                           Text="Подключённых расширений нет."
                                           Visibility="{Binding NoExtensions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding Extensions}"
                                              Visibility="{Binding HasExtensions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource EditorTextSecondaryBrush}"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="14,5"
                    HorizontalAlignment="Right"
                    Click="Close_OnClick"
                    Content="Закрыть"
                    Style="{StaticResource EditorDialogPrimaryButtonStyle}" />
        </Grid>
    </Border>
</Window>