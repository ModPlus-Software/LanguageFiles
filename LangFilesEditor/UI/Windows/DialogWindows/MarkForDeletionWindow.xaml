<Window x:Class="LangFilesEditor.UI.Windows.DialogWindows.MarkForDeletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Пометка к удалению"
        MinWidth="380"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource DefaultFont}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Текущее состояние записи. Текст заполняется из code-behind: он зависит
              от выбранной строки, а не от разметки  -->
        <Border Grid.Row="0"
                Style="{StaticResource EditorDialogSectionBorderStyle}">
            <TextBlock x:Name="TbState"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0 12 0 0">
            <TextBlock Style="{StaticResource EditorDialogFieldLabelStyle}"
                       Text="Удалить после версии" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas, Courier New"
                           Foreground="{DynamicResource GrayBrush2}"
                           Text="todo remove after" />
                <TextBox x:Name="TbVersion"
                         MinWidth="120"
                         VerticalAlignment="Center"
                         Style="{StaticResource EditorDialogTextBoxStyle}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0 16 0 0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="BtMark"
                    Click="Mark_OnClick"
                    Content="Mark"
                    Style="{StaticResource EditorDialogPrimaryButtonStyle}" />
            <Button x:Name="BtUnmark"
                    MinWidth="128"
                    Click="Unmark_OnClick"
                    Content="Unmark deletion"
                    Style="{StaticResource EditorDialogButtonStyle}" />
            <!--  IsCancel здесь не ставится: WPF по нему сам выставляет DialogResult,
                  и вместе с обработчиком Click значение присваивалось бы уже закрытому окну  -->
            <Button x:Name="BtCancel"
                    Margin="0"
                    Click="Cancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource EditorDialogButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
