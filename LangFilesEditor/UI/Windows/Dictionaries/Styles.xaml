<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infrastructure="clr-namespace:LangFilesEditor.UI.Infrastructure">

    <!--  Составные стили: карточки, плашки, вкладки модулей, оформление диалогов.
          Перенесено из сервера лицензий (ModPlusLicenseServer/Views/Styles.xaml),
          без кнопок пуска/остановки и оформления окна — в редакторе их нет.

          Controls.xaml подключён здесь, а не в App.xaml: BasedOn работает через
          StaticResource, и базовые стили обязаны быть доступны на момент разбора
          этого словаря. Порядок в App.xaml на это влиять не должен.  -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI/Windows/Dictionaries/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ==================== Карточки ====================  -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <!--  Border не обрезает содержимое по CornerRadius: непрозрачный потомок
              во всю ширину закрасил бы углы  -->
        <Setter Property="infrastructure:CornerClip.Radius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Шапка карточки: скругление только сверху, чтобы совпасть с рамкой  -->
    <Style x:Key="CardHeader" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Control.Border}" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="CornerRadius" Value="6 6 0 0" />
        <Setter Property="Padding" Value="10 6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InfoBanner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MainBlue}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="10 7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ==================== Метки состояния ====================  -->
    <Style x:Key="Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6 2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ChipText"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ==================== Ссылки ====================  -->
    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource MainDarkBlue}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ==================== Вкладки открытых модулей ====================  -->
    <!--  Тот же приём, что у боковой навигации сервера лицензий: выбранная вкладка
          получает акцентную полосу и цветную надпись, а не только другой фон  -->
    <Style x:Key="ModulesBarTabToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GrayBrush1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4 4 0 0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            <Border x:Name="AccentBar"
                                    Grid.Row="1"
                                    Background="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MouseOverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MainBlue}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource MainDarkBlue}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource MainDarkBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== Диалоговые окна ====================  -->
    <Style x:Key="EditorDialogTitleStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource EditorTextPrimaryBrush}" />
    </Style>

    <Style x:Key="EditorDialogSectionTitleStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource EditorTextPrimaryBrush}" />
    </Style>

    <Style x:Key="EditorDialogFieldLabelStyle"
           BasedOn="{StaticResource LabelTextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0 0 0 4" />
    </Style>

    <!--  Секция настроек: карточка на фоне окна  -->
    <Style x:Key="EditorDialogSectionBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="infrastructure:CornerClip.Radius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EditorDialogTextBoxStyle"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}" />

    <Style x:Key="EditorDialogComboBoxStyle"
           BasedOn="{StaticResource {x:Type ComboBox}}"
           TargetType="{x:Type ComboBox}" />

    <!--  Второстепенное действие диалога: контурная кнопка  -->
    <Style x:Key="EditorDialogButtonStyle"
           BasedOn="{StaticResource TransparentButton}"
           TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14 5" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Margin" Value="0 0 8 0" />
    </Style>

    <!--  Основное действие диалога: акцентная заливка. На окно ожидается одна такая кнопка  -->
    <Style x:Key="EditorDialogPrimaryButtonStyle"
           BasedOn="{StaticResource {x:Type Button}}"
           TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14 5" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Margin" Value="0 0 8 0" />
    </Style>

    <Style x:Key="EditorDialogLogTextBoxStyle"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Courier New" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>

    <!--  Значение «только для чтения» в настройках: читается как текст, а не как поле.
          Шаблон задан свой: в базовом стиле у IsReadOnly есть триггер заливки,
          а триггер шаблона перекрывает любое значение Background из стиля  -->
    <Style x:Key="EditorSettingsReadOnlyValueStyle"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
