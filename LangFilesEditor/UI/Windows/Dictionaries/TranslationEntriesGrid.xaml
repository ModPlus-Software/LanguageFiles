<UserControl x:Class="LangFilesEditor.UI.Windows.Dictionaries.TranslationEntriesGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LangFilesEditor.UI.Windows.Dictionaries"
             xmlns:infrastructure="clr-namespace:LangFilesEditor.UI.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Windows/Dictionaries/TranslationEntriesGridResources.xaml" />
                <ResourceDictionary Source="/UI/Windows/Dictionaries/ItemView.xaml" />
                <ResourceDictionary Source="/UI/Windows/Dictionaries/EntryGridTemplates.xaml" />
                <ResourceDictionary Source="/UI/Windows/Dictionaries/WorkspaceGridTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow"
                           Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   Margin="4 4 4 0"
                   Text="{Binding Header, RelativeSource={RelativeSource AncestorType=local:TranslationEntriesGrid}}"
                   TextWrapping="Wrap" />
        <!--  Грид оформлен как карточка: рамка и скругление те же, что у панелей сервера лицензий.
              CornerClip обязателен — сам Border содержимое по скруглению не обрезает,
              и непрозрачный грид закрасил бы углы  -->
        <Border Grid.Row="1"
                Margin="4 4 4 0"
                VerticalAlignment="Stretch"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource SolidColorBrush.Control.Border}"
                BorderThickness="1"
                CornerRadius="6"
                infrastructure:CornerClip.Radius="6"
                SnapsToDevicePixels="True">
            <DataGrid x:Name="EntriesDataGrid"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:TranslationEntriesGrid}}"
                      SelectionChanged="EntriesDataGrid_OnSelectionChanged"
                      Style="{StaticResource TranslationEntriesDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource TranslationEntriesDataGridColumnHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="NameColumn"
                                            Width="Auto" />
                    <DataGridTemplateColumn x:Name="RuColumn"
                                            Header="Русский&#x0a;ru-RU"
                                            Width="*" />
                    <DataGridTemplateColumn x:Name="UkColumn"
                                            Header="Українська&#x0a;uk-UA"
                                            Width="*" />
                    <DataGridTemplateColumn x:Name="EnColumn"
                                            Header="English&#x0a;en-US"
                                            Width="*" />
                    <DataGridTemplateColumn x:Name="DeColumn"
                                            Header="Deutsch&#x0a;de-DE"
                                            Width="*" />
                    <DataGridTemplateColumn x:Name="EsColumn"
                                            Header="Español&#x0a;es-ES"
                                            Width="*" />
                    <DataGridTemplateColumn x:Name="ZhColumn"
                                            Header="中文&#x0a;zh-CN"
                                            Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>