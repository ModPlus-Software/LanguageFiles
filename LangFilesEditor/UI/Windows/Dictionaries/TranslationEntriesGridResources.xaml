<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:workSpace="clr-namespace:LangFilesEditor.UI.Windows.MainWindow.WorkSpace">
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#D0D0D0" />
    <Style x:Key="TranslationEntriesDataGridColumnHeaderStyle"
           TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TranslationEntryValueTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TranslationEntryNameTextBlockStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip"
                Value="{Binding Path=RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
    </Style>

    <Style x:Key="TranslationEntriesDataGridStyle"
           TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource TranslationEntriesDataGridColumnHeaderStyle}" />
    </Style>

    <Style x:Key="TranslationEntriesEntryRowStyle"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{Binding RowVisualState, Converter={StaticResource RowVisualStateToBrushConverter}}" />
        <Setter Property="ToolTip"
                Value="{Binding RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
    </Style>

    <Style x:Key="TranslationEntriesDataGridRowStyle"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="Background"
                Value="White" />
        <Setter Property="MinHeight"
                Value="40" />
        <Setter Property="Height"
                Value="40" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}"
                         Value="{x:Static workSpace:WorkspaceRowKind.ModuleHeader}">
                <Setter Property="Background"
                        Value="{StaticResource WorkspaceModuleHeaderBrush}" />
                <Setter Property="MinHeight"
                        Value="34" />
                <Setter Property="Height"
                        Value="Auto" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}"
                         Value="{x:Static workSpace:WorkspaceRowKind.Entry}">
                <Setter Property="Background"
                        Value="{Binding RowBackground}" />
                <Setter Property="ToolTip"
                        Value="{Binding RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>