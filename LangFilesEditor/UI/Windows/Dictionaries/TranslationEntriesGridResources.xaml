<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:workSpace="clr-namespace:LangFilesEditor.UI.Windows.MainWindow.WorkSpace">

    <!--  Стили наследуют базовые из Controls.xaml через BasedOn: у стиля с x:Key
          неявный стиль того же типа не применяется, и без BasedOn грид выпал бы
          из общего оформления. Базовые стили ищутся в ресурсах приложения —
          они загружены раньше, чем создаётся любой UserControl.

          Кисть выделения (SystemColors.HighlightBrushKey) задана в словарях темы:
          её значение зависит от темы, а этот словарь общий для обеих.  -->

    <Style x:Key="TranslationEntriesDataGridColumnHeaderStyle"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"
           TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GrayBrush1}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Поле в ячейке: без заливки, но с рамкой нулевого цвета — так наведение
          и фокус подсвечивают именно редактируемую ячейку, как в полях сервера лицензий  -->
    <Style x:Key="TranslationEntryValueTextBoxStyle"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="3 2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TranslationEntryNameTextBlockStyle"
           BasedOn="{StaticResource {x:Type TextBlock}}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="3 2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip" Value="{Binding Path=RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
    </Style>

    <Style x:Key="TranslationEntriesDataGridStyle"
           BasedOn="{StaticResource {x:Type DataGrid}}"
           TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />

        <!--  CanContentScroll обязан быть True: при False ScrollContentPresenter меряет
              список с бесконечной высотой, VirtualizingStackPanel реализует все строки,
              и три сеттера выше не работают. На модуле в несколько тысяч записей это
              сотни тысяч элементов в дереве — отсюда долгое открытие модуля и
              многосекундное переключение темы (оно обходит всё дерево).
              ScrollUnit=Pixel возвращает плавную прокрутку, ради которой,
              судя по всему, и был выставлен False: строки разной высоты из-за переносов.  -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!--  ColumnHeaderStyle сюда не ставится: DataGrid переносит его в шапку только
              если приоритет значения выше, чем у стиля самой шапки, а неявный стиль
              DataGridColumnHeader (ImplicitStyleReference) выигрывает у сеттера стиля.
              Поэтому он задан прямо на элементе в TranslationEntriesGrid.xaml  -->
    </Style>

    <Style x:Key="TranslationEntriesEntryRowStyle"
           BasedOn="{StaticResource {x:Type DataGridRow}}"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{Binding RowVisualState, Converter={StaticResource RowVisualStateToBrushConverter}}" />
        <Setter Property="ToolTip" Value="{Binding RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
    </Style>

    <Style x:Key="TranslationEntriesDataGridRowStyle"
           BasedOn="{StaticResource {x:Type DataGridRow}}"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource EditorRowDefaultBrush}" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}"
                         Value="{x:Static workSpace:WorkspaceRowKind.ModuleHeader}">
                <Setter Property="Background" Value="{DynamicResource WorkspaceModuleHeaderBrush}" />
                <Setter Property="Height" Value="Auto" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}"
                         Value="{x:Static workSpace:WorkspaceRowKind.Entry}">
                <Setter Property="Background" Value="{Binding RowBackground}" />
                <Setter Property="ToolTip" Value="{Binding RowToolTip, Converter={StaticResource NullIfEmptyStringConverter}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
