<Window x:Class="LangFilesEditor.UI.Windows.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainWindow="clr-namespace:LangFilesEditor.UI.Windows.MainWindow"
        xmlns:workSpace="clr-namespace:LangFilesEditor.UI.Windows.MainWindow.WorkSpace"
        xmlns:docking="clr-namespace:LangFilesEditor.UI.Infrastructure.Docking"
        Title="Translations Editor"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource DefaultFont}"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <docking:DockSite x:Name="DockSite">
                <docking:DockSite.WorkSpaceContent>
                    <workSpace:WorkSpace DataContext="{Binding WorkSpaceVM}"
                                         MinHeight="100" />
                </docking:DockSite.WorkSpaceContent>
            </docking:DockSite>
            <Grid x:Name="PanelStaging"
                  Visibility="Collapsed">
            
            <docking:DockablePanel x:Name="NavDockPanel"
                                   DockSide="Left"
                                   ChromePlacement="Left">
                <docking:DockablePanel.PanelContent>
                    <mainWindow:NavBar MinWidth="180" />
                </docking:DockablePanel.PanelContent>
            </docking:DockablePanel>
            
            
            <docking:DockablePanel x:Name="ToolDockPanel"
                                   DockSide="Right"
                                   ChromePlacement="Right">
                <docking:DockablePanel.PanelContent>
                    <mainWindow:ToolBar />
                </docking:DockablePanel.PanelContent>
            </docking:DockablePanel>
            
            
            <docking:DockablePanel x:Name="SearchDockPanel"
                                   DockSide="Top"
                                   ChromePlacement="Top">
                <docking:DockablePanel.PanelContent>
                    <mainWindow:SearchBar />
                </docking:DockablePanel.PanelContent>
            </docking:DockablePanel>
            
            
            <docking:DockablePanel x:Name="AttributesDockPanel"
                                   DockSide="Bottom"
                                   ChromePlacement="Top">
                <docking:DockablePanel.PanelContent>
                    <mainWindow:AttributesWindow MinHeight="100" />
                </docking:DockablePanel.PanelContent>
            </docking:DockablePanel>
            
            </Grid>
        </Grid>
        <Border Grid.Row="1"
                Background="{DynamicResource EditorChromeBrushLight}"
                BorderBrush="{DynamicResource EditorBorderBrush}"
                BorderThickness="0,1,0,0">
            <mainWindow:StatusBar DataContext="{Binding StatusBarVM}" />
        </Border>
    </Grid>
</Window>