<UserControl x:Class="LangFilesEditor.UI.Windows.MainWindow.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="56"
             d:DesignWidth="800">
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Margin="0 0 8 0"
                   VerticalAlignment="Top"
                   Padding="0 5 0 0"
                   Text="Search:" />

        <StackPanel Grid.Column="1">
            <TextBox MinHeight="26"
                     Padding="8 0 4 0"
                     HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Center"
                     Text="{Binding Path=QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Margin="0 6 0 0"
                        Orientation="Horizontal">
                <CheckBox Margin="0 0 12 0"
                          Content="Common"
                          IsChecked="{Binding Path=SearchInCommon, Mode=TwoWay}"
                          IsEnabled="{Binding Path=IsSearchInCommonEnabled}" />
                <CheckBox Margin="0 0 12 0"
                          Content="Open modules"
                          IsChecked="{Binding Path=SearchInOpenModules, Mode=TwoWay}"
                          IsEnabled="{Binding Path=IsSearchInOpenModulesEnabled}" />
                <CheckBox Content="All modules"
                          IsChecked="{Binding Path=SearchInAllModules, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>