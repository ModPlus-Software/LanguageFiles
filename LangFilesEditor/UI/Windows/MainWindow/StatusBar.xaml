<UserControl x:Class="LangFilesEditor.UI.Windows.MainWindow.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LangFilesEditor.UI.Windows.MainWindow"
             mc:Ignorable="d"
             d:DesignHeight="26"
             d:DesignWidth="600"
             MinHeight="26"
             MaxHeight="26">
    
    <UserControl.Resources>
        <DataTemplate x:Key="StatusLabelTemplate">
            <TextBlock VerticalAlignment="Center"
                       MaxWidth="{Binding LabelMaxWidth}"
                       FontSize="11.5"
                       Foreground="{StaticResource EditorTextSecondaryBrush}"
                       Text="{Binding Text}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ToolTip}" />
        </DataTemplate>

        <DataTemplate x:Key="StatusArrowTemplate">
            <TextBlock Margin="6,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource EditorTextSecondaryBrush}"
                       Text="→" />
        </DataTemplate>

        <DataTemplate x:Key="StatusSeparatorTemplate">
            <TextBlock Margin="10,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource EditorTextPrimaryBrush}"
                       Text="|" />
        </DataTemplate>

        <Style x:Key="EditorProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Background"
                    Value="{StaticResource EditorProgressTrackBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource EditorAccentBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"
                                        Background="Transparent" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate"
                                     Value="True">
                                <Setter TargetName="PART_Indicator"
                                        Property="HorizontalAlignment"
                                        Value="Stretch" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="IndeterminatePulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25"
                                                             To="0.75"
                                                             Duration="0:0:0.9"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndeterminatePulse" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagnosticChipToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="5,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Chip"
                                        Property="Background"
                                        Value="{StaticResource EditorHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Chip"
                                        Property="Background"
                                        Value="{StaticResource EditorSelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagnosticModuleLinkStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="6,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource EditorHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DiagnosticCategoryTemplate">
            <Grid Margin="2,0,0,0"
                  Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseEnter="DiagnosticExpandIcon_MouseEnter"
                            MouseLeave="DiagnosticExpandIcon_MouseLeave"
                            ToolTip="Показать по модулям">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource EditorTextSecondaryBrush}"
                                   Text="▴" />
                    </Border>
                    <ToggleButton Style="{StaticResource DiagnosticChipToggleStyle}"
                                  IsChecked="{Binding IsFilterActive, Mode=OneWay}"
                                  Command="{Binding DataContext.ToggleDiagnosticFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="{Binding Title}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9"
                                     Height="9"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={StaticResource DiagnosticSeverityToBrushConverter}}" />
                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{StaticResource EditorTextSecondaryBrush}"
                                       Text="{Binding Count}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <Popup AllowsTransparency="True"
                       Placement="Top"
                       PopupAnimation="Fade"
                       StaysOpen="True"
                       VerticalOffset="-4">
                    <Border x:Name="DiagnosticPopupRoot"
                            MinWidth="220"
                            MaxWidth="340"
                            Margin="8"
                            Padding="10,8"
                            Background="{StaticResource EditorChromeBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MouseEnter="DiagnosticPopup_MouseEnter"
                            MouseLeave="DiagnosticPopup_MouseLeave">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              Opacity="0.4"
                                              ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9"
                                         Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource DiagnosticSeverityToBrushConverter}}" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource EditorTextPrimaryBrush}"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource EditorTextSecondaryBrush}"
                                           Text="{Binding Count}" />
                            </StackPanel>
                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DiagnosticModuleLinkStyle}"
                                                ToolTip="{Binding ModuleName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource EditorTextSecondaryBrush}"
                                                           Text="{Binding ModuleName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource EditorTextPrimaryBrush}"
                                                           Text="{Binding Count}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:StatusBarSegmentVm}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate"
                                Value="{StaticResource StatusLabelTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="Arrow">
                                <Setter Property="ContentTemplate"
                                        Value="{StaticResource StatusArrowTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="Separator">
                                <Setter Property="ContentTemplate"
                                        Value="{StaticResource StatusSeparatorTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel x:Name="RootPanel"
               Margin="10,0,14,0"
               LastChildFill="True"
               SizeChanged="OnRootSizeChanged">
        <StackPanel x:Name="ProgressPanel"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource EditorTextPrimaryBrush}"
                       Text="|" />

            <Border x:Name="ExpandIcon"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseEnter="ExpandIcon_MouseEnter"
                    MouseLeave="ExpandIcon_MouseLeave"
                    ToolTip="Показать все операции">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource EditorTextSecondaryBrush}"
                           Text="▴" />
            </Border>

            <TextBlock Margin="6,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       MaxWidth="220"
                       Foreground="{StaticResource EditorTextSecondaryBrush}"
                       Text="{Binding OperationsHeader}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProgressToolTip}" />

            <ProgressBar Width="130"
                         Height="6"
                         VerticalAlignment="Center"
                         Style="{StaticResource EditorProgressBarStyle}"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding OverallProgress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsOverallIndeterminate}"
                         ToolTip="{Binding ProgressToolTip}" />

            <Popup x:Name="OperationsPopup"
                   AllowsTransparency="True"
                   Placement="Top"
                   PlacementTarget="{Binding ElementName=ProgressPanel}"
                   PopupAnimation="Fade"
                   StaysOpen="True"
                   VerticalOffset="-4">
                <Border x:Name="PopupRoot"
                        MinWidth="240"
                        MaxWidth="340"
                        Margin="8"
                        Padding="10,8"
                        Background="{StaticResource EditorChromeBrush}"
                        BorderBrush="{StaticResource EditorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MouseEnter="Popup_MouseEnter"
                        MouseLeave="Popup_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          Opacity="0.4"
                                          ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource EditorTextPrimaryBrush}"
                                   Text="Выполняемые операции" />
                        <ItemsControl Margin="0,6,0,0"
                                      ItemsSource="{Binding ActiveOperations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource EditorTextSecondaryBrush}"
                                                   Text="{Binding DisplayText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Row="1"
                                                     Height="5"
                                                     Margin="0,4,0,0"
                                                     Style="{StaticResource EditorProgressBarStyle}"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Fraction, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <StackPanel x:Name="DiagnosticsPanel"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
            <ItemsControl ItemTemplate="{StaticResource DiagnosticCategoryTemplate}"
                          ItemsSource="{Binding Diagnostics.Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <ItemsControl x:Name="StatusHost"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding StatusSegments}"
                      ToolTip="{Binding StatusToolTip}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DockPanel>
</UserControl>