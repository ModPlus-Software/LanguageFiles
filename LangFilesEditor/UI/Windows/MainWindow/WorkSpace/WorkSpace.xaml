<UserControl x:Class="LangFilesEditor.UI.Windows.MainWindow.WorkSpace.WorkSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:workSpace="clr-namespace:LangFilesEditor.UI.Windows.MainWindow.WorkSpace"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <workSpace:ModulesBar Grid.Row="0"
                              DataContext="{Binding ModulesBarVM}"
                              Visibility="{Binding IsModulesBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <workSpace:ModuleView Grid.Row="1"
                              VerticalAlignment="Stretch"
                              DataContext="{Binding ModuleViewVM}"
                              MinHeight="100" />
    </Grid>
</UserControl>