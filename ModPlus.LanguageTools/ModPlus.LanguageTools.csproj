<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Общая библиотека работы с файлами локализации ModPlus: проверки, исправление кавычек,
    сборка (слияние) языковых файлов, версия пакета локализации (Langs.xml) и выгрузка
    на серверы и в хранилище. Используется консольной утилитой ModPlus.LanguageTools.Cli,
    редактором LangFilesEditor, программой сборки ModPlusBuilder и расширением Visual Studio ModPlusVSTools.
    Библиотека намеренно без WPF и без Windows-зависимостей: утилита запускается
    в GitHub Actions на Linux.

    netstandard2.0 нужен расширению ModPlusVSTools: Visual Studio работает на .NET Framework 4.8
    и не может загрузить сборку net8.0. В этой сборке нет выгрузки (папка Publishing и пакеты
    AWSSDK.S3/SSH.NET) — расширению нужны только проверка и сборка языковых файлов.
    Совместимость: без Span/Range/ThrowIfNull и прочих API .NET 5+; недостающие для компилятора
    типы — в NetStandardPolyfills.cs.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Явный список глобальных using: неявные using SDK для netstandard2.0 включаются не полностью -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Версии совпадают с ModPlusBuilder: он подключает эту библиотеку проектом -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.305.18" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Выгрузка (серверы, хранилище) только в net8.0: в netstandard2.0 она не нужна и тянула бы лишние пакеты -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Publishing\**" />
  </ItemGroup>

</Project>
